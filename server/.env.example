# Порт HTTP-сервера Express
PORT=3001

# Среда выполнения (development / production / test)
NODE_ENV=development

# База данных проекта размещена в облаке Neon Serverless PostgreSQL.
# DATABASE_URL — строка подключения через пулер соединений (PgBouncer) для регулярных запросов приложения
DATABASE_URL=

# DIRECT_URL — прямое подключение без пулера (порт 5432) для выполнения миграций Prisma (prisma migrate)
DIRECT_URL=

# Секретный ключ для сессий (в продакшене — случайная криптографическая строка от 32 байт)
SESSION_SECRET=
